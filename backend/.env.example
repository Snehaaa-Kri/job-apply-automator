# Server
APP_ENV=development
APP_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=job_automator
DB_SSL_MODE=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRY_HOURS=24

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=job-automator-group

# AWS S3
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=job-automator-resumes
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
